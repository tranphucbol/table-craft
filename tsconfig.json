{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@table-craft/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@table-craft/plugin-api/*": ["packages/plugin-api/src/*"],
      "@table-craft/core": ["packages/core/src/index.ts"],
      "@table-craft/core/*": ["packages/core/src/*"],
      "@table-craft/desktop/*": ["packages/desktop/src/*"],
      "@table-craft/plugin-sqlite": ["plugins/sqlite/src/index.ts"],
      "@table-craft/plugin-redis": ["plugins/redis/src/index.ts"],
      "@table-craft/plugin-redis/*": ["plugins/redis/src/*"],
      "@table-craft/plugin-postgres": ["plugins/postgres/src/index.ts"],
      "@table-craft/plugin-mysql": ["plugins/mysql/src/index.ts"],
      "@table-craft/plugin-sqlite/explain": ["plugins/sqlite/src/explain.ts"],
      "@table-craft/plugin-postgres/explain": ["plugins/postgres/src/explain.ts"],
      "@table-craft/plugin-mysql/explain": ["plugins/mysql/src/explain.ts"],
      "@table-craft/plugin-postgres/bulk": ["plugins/postgres/src/bulk.ts"],
      "@table-craft/plugin-mysql/bulk": ["plugins/mysql/src/bulk.ts"],
      "@table-craft/plugin-mysql/server": ["plugins/mysql/src/server.ts"],
      "@table-craft/plugin-mysql/functions": ["plugins/mysql/src/functions/index.ts"],
      "@table-craft/plugin-mysql/warnings": ["plugins/mysql/src/warnings.ts"],
      "@table-craft/plugin-mysql/introspect": ["plugins/mysql/src/introspect.ts"],
      "@table-craft/plugin-postgres/notices": ["plugins/postgres/src/notices.ts"],
      "@table-craft/plugin-postgres/sessions": ["plugins/postgres/src/sessions.ts"],
      "@table-craft/plugin-mysql/sessions": ["plugins/mysql/src/sessions.ts"],
      "@table-craft/plugin-sqlite/errorPosition": ["plugins/sqlite/src/errorPosition.ts"],
      "@table-craft/plugin-postgres/errorPosition": ["plugins/postgres/src/errorPosition.ts"],
      "@table-craft/plugin-mysql/errorPosition": ["plugins/mysql/src/errorPosition.ts"]
    },
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/vite.*.ts",
    "packages/*/scripts/**/*.ts",
    "plugins/*/src/**/*.ts",
    "plugins/*/scripts/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.db.config.ts"
  ],
  // The renderer targets a browser, not Node: it gets its own program, with DOM, in plan 001.
  "exclude": ["packages/desktop/src/renderer/**", "test/renderer/**"]
}
