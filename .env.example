# Copy to .env (git-ignored). A remote TiDB the database suites use instead of the emulated
# TiDB container whenever it answers (test/db/tidbTarget.ts). The suites only create, use and
# drop their own tc_run_* databases on it. Leave the host empty to always use the container.
TABLE_CRAFT_TIDB_REMOTE_HOST=
TABLE_CRAFT_TIDB_REMOTE_PORT=4000
TABLE_CRAFT_TIDB_REMOTE_USER=
TABLE_CRAFT_TIDB_REMOTE_PASSWORD=
