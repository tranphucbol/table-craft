-    map(changes) {
+    map(changes, assoc = 0) {
+        if (assoc) {
+            let pos = changes.mapPos(this.from, assoc, state.MapMode.TrackDel);
+            return pos == null ? null : new FieldRange(this.field, pos, pos);
+        }
         let from = changes.mapPos(this.from, -1, state.MapMode.TrackDel);
         let to = changes.mapPos(this.to, 1, state.MapMode.TrackDel);
