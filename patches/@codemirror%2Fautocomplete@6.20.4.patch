@@ -1538,8 +1542,15 @@ class ActiveSnippet {
     }
     map(changes) {
         let ranges = [];
-        for (let r of this.ranges) {
-            let mapped = r.map(changes);
+        for (let i = 0; i < this.ranges.length; i++) {
+            let r = this.ranges[i], assoc = 0;
+            if (r.from == r.to && r.field != this.active) {
+                // Upstream src/snippet.ts (code.haverbeke.berlin/codemirror/autocomplete): remove once inactive empty fields stay collapsed.
+                // Array order is textual, unlike field numbers (notably the final ${0}).
+                let active = this.ranges.findIndex(other => other.field == this.active && other.from <= r.from && other.to >= r.to);
+                assoc = active < 0 || active < i ? 1 : -1;
+            }
+            let mapped = r.map(changes, assoc);
             if (!mapped)
                 return null;
             ranges.push(mapped);
