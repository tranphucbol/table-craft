{
  // Renderer tests compile against lib.dom, like the renderer they test; the root program has no
  // DOM and excludes this directory. `bun run typecheck` runs all three programs.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // `paths` replaces the root's map rather than merging, so the root's entries are repeated here.
    "paths": {
      "@table-craft/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@table-craft/plugin-api/*": ["packages/plugin-api/src/*"],
      "@table-craft/core": ["packages/core/src/index.ts"],
      "@table-craft/core/*": ["packages/core/src/*"],
      "@table-craft/desktop/*": ["packages/desktop/src/*"],
      // CodeMirror is the renderer's dependency; its tests use the same copy (vitest.config.ts).
      "@codemirror/*": ["packages/desktop/node_modules/@codemirror/*"]
    }
  },
  "include": ["**/*.ts", "../../packages/desktop/src/renderer/vite-env.d.ts"],
  "exclude": []
}
