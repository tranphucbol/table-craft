# The etcd fixture keys, sourced by test/db/etcd/seed.sh on every etcd server: one `put` per key,
# etcdctl's arguments with shell quoting. $LEASE is a ten-year lease the seeder grants first.
put /app/config/db.json '{"host":"db.internal","port":5432,"pool":{"min":2,"max":10},"tags":["primary","eu"]}'
put /app/config/app.properties 'log.level=info
http.port=8080'
put /app/feature/flags 'dark-mode,beta-search'
put '/app/name with spaces' 'spaced value'
put --lease="$LEASE" /app/session/token 'expiring'
put /registry/namespaces/default '{"kind":"Namespace","metadata":{"name":"default"}}'
put /registry/pods/default/web-0 '{"kind":"Pod","metadata":{"name":"web-0","namespace":"default"}}'
put /registry/pods/default/web-1 '{"kind":"Pod","metadata":{"name":"web-1","namespace":"default"}}'
put /registry/services/specs/default/kubernetes '{"kind":"Service","metadata":{"name":"kubernetes"}}'
put "$(printf '/bin/\377\376')" 'binary key'
printf '\377\376\000\001' | put /probe/binary
put /probe/string 'hello'
put /bulk/key-01 'value 01'
put /bulk/key-02 'value 02'
put /bulk/key-03 'value 03'
put /bulk/key-04 'value 04'
put /bulk/key-05 'value 05'
put /bulk/key-06 'value 06'
put /bulk/key-07 'value 07'
put /bulk/key-08 'value 08'
put /bulk/key-09 'value 09'
put /bulk/key-10 'value 10'
put /bulk/key-11 'value 11'
put /bulk/key-12 'value 12'
put /bulk/key-13 'value 13'
put /bulk/key-14 'value 14'
put /bulk/key-15 'value 15'
put /bulk/key-16 'value 16'
put /bulk/key-17 'value 17'
put /bulk/key-18 'value 18'
put /bulk/key-19 'value 19'
put /bulk/key-20 'value 20'
put /bulk/key-21 'value 21'
put /bulk/key-22 'value 22'
put /bulk/key-23 'value 23'
put /bulk/key-24 'value 24'
put /bulk/key-25 'value 25'
put /bulk/key-26 'value 26'
put /bulk/key-27 'value 27'
put /bulk/key-28 'value 28'
put /bulk/key-29 'value 29'
put /bulk/key-30 'value 30'
put /seed/probe 1
