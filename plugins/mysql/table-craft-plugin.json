{
  "id": "mysql",
  "name": "MySQL",
  "version": "0.0.0",
  "apiVersion": "1.4.0",
  "entry": "index.js",
  "capabilities": [
    "sql",
    "cancel",
    "schemaTree",
    "transactions",
    "ddl",
    "explain",
    "explainAnalyze",
    "currentNamespace",
    "keepAlive",
    "bulkInsert",
    "objects",
    "serverMessages",
    "sessions",
    "routineCall"
  ],
  "highlight": "mysql",
  "connection": {
    "fields": [
      {
        "key": "host",
        "label": "Host",
        "kind": "text",
        "default": "localhost",
        "required": true
      },
      {
        "key": "port",
        "label": "Port",
        "kind": "number",
        "default": 3306,
        "required": true
      },
      {
        "key": "database",
        "label": "Database",
        "kind": "text",
        "placeholder": "optional"
      },
      {
        "key": "user",
        "label": "User",
        "kind": "text",
        "required": true
      },
      {
        "key": "password",
        "label": "Password",
        "kind": "password",
        "secret": true
      },
      {
        "key": "sslMode",
        "label": "SSL mode",
        "kind": "select",
        "default": "disable",
        "group": "advanced",
        "options": [
          {
            "value": "disable",
            "label": "Disable"
          },
          {
            "value": "require",
            "label": "Require"
          },
          {
            "value": "verify-ca",
            "label": "Verify CA"
          },
          {
            "value": "verify-full",
            "label": "Verify full"
          }
        ]
      },
      {
        "key": "sslRootCert",
        "label": "SSL root certificate",
        "kind": "file",
        "group": "advanced"
      },
      {
        "key": "sslCert",
        "label": "Client certificate",
        "kind": "file",
        "group": "advanced"
      },
      {
        "key": "sslKey",
        "label": "Client key",
        "kind": "file",
        "group": "advanced"
      },
      {
        "key": "sslKeyPassphrase",
        "label": "Client key passphrase",
        "kind": "password",
        "secret": true,
        "group": "advanced"
      },
      {
        "key": "connectTimeout",
        "label": "Connect timeout (s)",
        "kind": "number",
        "default": 10,
        "group": "advanced"
      }
    ],
    "url": {
      "schemes": ["mysql", "mariadb"],
      "form": "server",
      "parts": {
        "host": "host",
        "port": "port",
        "database": "database",
        "user": "user",
        "password": "password"
      },
      "params": [
        {
          "name": "ssl-mode",
          "key": "sslMode",
          "values": {
            "DISABLED": "disable",
            "REQUIRED": "require",
            "VERIFY_CA": "verify-ca",
            "VERIFY_IDENTITY": "verify-full"
          }
        },
        { "name": "ssl-ca", "key": "sslRootCert" },
        { "name": "ssl-cert", "key": "sslCert" },
        { "name": "ssl-key", "key": "sslKey" }
      ]
    },
    "network": { "host": "host", "port": "port", "connectTimeout": "connectTimeout" },
    "tls": {
      "mode": "sslMode",
      "verifyModes": ["verify-ca", "verify-full"],
      "caFile": "sslRootCert",
      "certFile": "sslCert",
      "keyFile": "sslKey",
      "keyPassphrase": "sslKeyPassphrase"
    }
  }
}
