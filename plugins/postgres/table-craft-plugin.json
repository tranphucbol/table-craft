{
  "id": "postgres",
  "name": "PostgreSQL",
  "version": "0.0.0",
  "apiVersion": "1.6.0",
  "entry": "index.js",
  "capabilities": [
    "sql",
    "cancel",
    "schemaTree",
    "transactions",
    "ddl",
    "explain",
    "explainAnalyze",
    "currentNamespace",
    "keepAlive",
    "bulkInsert",
    "objects",
    "serverMessages",
    "sessions",
    "routineCall",
    "serverTimeout"
  ],
  "highlight": "postgresql",
  "brands": [{ "id": "postgresql", "name": "PostgreSQL" }],
  "connection": {
    "fields": [
      { "key": "host", "label": "Host", "kind": "text", "default": "localhost", "required": true },
      { "key": "port", "label": "Port", "kind": "number", "default": 5432, "required": true },
      { "key": "database", "label": "Database", "kind": "text", "default": "postgres", "required": true },
      { "key": "user", "label": "User", "kind": "text", "required": true },
      { "key": "password", "label": "Password", "kind": "password", "secret": true },
      {
        "key": "sslMode",
        "label": "SSL mode",
        "kind": "select",
        "default": "disable",
        "group": "advanced",
        "options": [
          { "value": "disable", "label": "Disable" },
          { "value": "require", "label": "Require" },
          { "value": "verify-ca", "label": "Verify CA" },
          { "value": "verify-full", "label": "Verify full" }
        ]
      },
      { "key": "sslRootCert", "label": "SSL root certificate", "kind": "file", "group": "advanced" },
      { "key": "sslCert", "label": "Client certificate", "kind": "file", "group": "advanced" },
      { "key": "sslKey", "label": "Client key", "kind": "file", "group": "advanced" },
      {
        "key": "sslKeyPassphrase",
        "label": "Client key passphrase",
        "kind": "password",
        "secret": true,
        "group": "advanced"
      },
      {
        "key": "connectTimeout",
        "label": "Connect timeout (s)",
        "kind": "number",
        "default": 10,
        "group": "advanced"
      },
      {
        "key": "applicationName",
        "label": "Application name",
        "kind": "text",
        "default": "TableCraft",
        "group": "advanced"
      }
    ],
    "url": {
      "schemes": ["postgresql", "postgres"],
      "form": "server",
      "parts": { "host": "host", "port": "port", "database": "database", "user": "user", "password": "password" },
      "params": [
        {
          "name": "sslmode",
          "key": "sslMode",
          "values": {
            "disable": "disable",
            "require": "require",
            "verify-ca": "verify-ca",
            "verify-full": "verify-full"
          }
        },
        { "name": "sslrootcert", "key": "sslRootCert" },
        { "name": "sslcert", "key": "sslCert" },
        { "name": "sslkey", "key": "sslKey" },
        { "name": "connect_timeout", "key": "connectTimeout" },
        { "name": "application_name", "key": "applicationName" }
      ]
    },
    "network": { "host": "host", "port": "port", "connectTimeout": "connectTimeout" },
    "tls": {
      "mode": "sslMode",
      "verifyModes": ["verify-ca", "verify-full"],
      "caFile": "sslRootCert",
      "certFile": "sslCert",
      "keyFile": "sslKey",
      "keyPassphrase": "sslKeyPassphrase"
    }
  }
}
