{
  "id": "redis",
  "name": "Redis",
  "version": "0.0.0",
  "apiVersion": "1.10.0",
  "entry": "index.js",
  "capabilities": ["commands", "cancel", "keepAlive", "keyValue", "nodes", "serverInfo", "sessions"],
  "highlight": "redis",
  "brands": [{ "id": "redis", "name": "Redis" }],
  "connection": {
    "fields": [
      {
        "key": "mode",
        "label": "Mode",
        "kind": "select",
        "default": "standalone",
        "required": true,
        "options": [
          { "value": "standalone", "label": "Standalone" },
          { "value": "sentinel", "label": "Sentinel" },
          { "value": "cluster", "label": "Cluster" }
        ]
      },
      { "key": "host", "label": "Host", "kind": "text", "default": "localhost", "required": true },
      { "key": "port", "label": "Port", "kind": "number", "default": 6379, "required": true },
      { "key": "user", "label": "Username", "kind": "text" },
      { "key": "password", "label": "Password", "kind": "password", "secret": true },
      {
        "key": "masterName",
        "label": "Master name",
        "kind": "text",
        "default": "mymaster",
        "required": true,
        "visibleWhen": { "key": "mode", "equals": "sentinel" }
      },
      {
        "key": "sentinels",
        "label": "Other sentinels",
        "kind": "text",
        "placeholder": "10.0.1.6:26379, 10.0.1.7:26379",
        "visibleWhen": { "key": "mode", "equals": "sentinel" }
      },
      {
        "key": "sentinelUser",
        "label": "Sentinel username",
        "kind": "text",
        "visibleWhen": { "key": "mode", "equals": "sentinel" }
      },
      {
        "key": "sentinelPassword",
        "label": "Sentinel password",
        "kind": "password",
        "secret": true,
        "visibleWhen": { "key": "mode", "equals": "sentinel" }
      },
      {
        "key": "database",
        "label": "Database",
        "kind": "number",
        "default": 0,
        "required": true,
        "visibleWhen": { "key": "mode", "equals": ["standalone", "sentinel"] }
      },
      {
        "key": "nodeAddressMap",
        "label": "Node address map",
        "kind": "text",
        "group": "advanced",
        "placeholder": "10.0.1.5:6379=127.0.0.1:7001, …",
        "visibleWhen": { "key": "mode", "equals": ["cluster", "sentinel"] }
      },
      {
        "key": "tlsMode",
        "label": "TLS mode",
        "kind": "select",
        "default": "disable",
        "group": "advanced",
        "options": [
          { "value": "disable", "label": "Disable" },
          { "value": "require", "label": "Require" },
          { "value": "verify-ca", "label": "Verify CA" },
          { "value": "verify-full", "label": "Verify full" }
        ]
      },
      { "key": "tlsCa", "label": "CA certificate", "kind": "file", "group": "advanced" },
      { "key": "tlsCert", "label": "Client certificate", "kind": "file", "group": "advanced" },
      { "key": "tlsKey", "label": "Client key", "kind": "file", "group": "advanced" },
      {
        "key": "tlsKeyPassphrase",
        "label": "Client key passphrase",
        "kind": "password",
        "secret": true,
        "group": "advanced"
      },
      { "key": "clientName", "label": "Client name", "kind": "text", "default": "TableCraft", "group": "advanced" },
      { "key": "keyDelimiter", "label": "Key delimiter", "kind": "text", "default": ":", "group": "advanced" },
      { "key": "scanBatch", "label": "SCAN batch", "kind": "number", "default": 1000, "group": "advanced" },
      {
        "key": "connectTimeout",
        "label": "Connect timeout (s)",
        "kind": "number",
        "default": 10,
        "group": "advanced"
      }
    ],
    "url": {
      "schemes": ["redis", "rediss"],
      "form": "server",
      "parts": { "host": "host", "port": "port", "database": "database", "user": "user", "password": "password" },
      "params": [],
      "sets": { "redis": { "mode": "standalone" }, "rediss": { "mode": "standalone", "tlsMode": "require" } }
    },
    "network": { "host": "host", "port": "port", "connectTimeout": "connectTimeout" },
    "tls": {
      "mode": "tlsMode",
      "verifyModes": ["verify-ca", "verify-full"],
      "caFile": "tlsCa",
      "certFile": "tlsCert",
      "keyFile": "tlsKey",
      "keyPassphrase": "tlsKeyPassphrase"
    }
  }
}
